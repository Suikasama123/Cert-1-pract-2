{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using":  [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { 
        "Name": "File", 
        "Args": { 
          "path": "log.log", 
          "rollingInterval": "Day"
        } 
      },
      {
        "Name": "Console"
      }
    ]
  }
}
